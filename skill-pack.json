    },
    {
      "name": "grill-with-curriculum",
      "path": "skills/entry/grill-with-curriculum",
      "role": "성취기준과 기존 자료에 근거한 수업 설계 검토"
    },
    {
      "name": "assessment-first-design",
      "path": "skills/assessment/assessment-first-design",
      "role": "활동보다 학습 증거, 성공 기준, 피드백 루프를 먼저 설계"
    },
    {
      "name": "diagnose-lesson-failure",
      "path": "skills/diagnostics/diagnose-lesson-failure",
