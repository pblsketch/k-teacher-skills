    {
      "name": "rubric-quality-guard",
      "path": "skills/assessment/rubric-quality-guard",
      "role": "루브릭 준거, 수준 기술, 성취기준 정렬 검토"
    },
    {
      "name": "hinge-question-designer",
      "path": "skills/assessment/hinge-question-designer",
      "role": "오개념을 드러내는 힌지 질문과 형성평가 설계"
