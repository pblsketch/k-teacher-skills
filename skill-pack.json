      "name": "udl-barrier-remover",
      "path": "skills/individualization/udl-barrier-remover",
      "role": "참여·표상·행동과 표현 장벽 진단과 UDL 대안 설계"
    },
    {
      "name": "k-teacher-workflow-router",
      "path": "skills/entry/k-teacher-workflow-router",
      "role": "교사 요청을 분석해 적절한 workflow와 첫 스킬로 라우팅"
    }
  ],
  "workflows": [
    {
