    {
      "name": "concept-based-inquiry-designer",
      "path": "skills/inquiry-pbl/concept-based-inquiry-designer",
      "role": "핵심 개념, 일반화, 탐구 질문 중심의 개념 기반 탐구 설계"
    },
    {
      "name": "differentiate-lesson-pathways",
      "path": "skills/individualization/differentiate-lesson-pathways",
      "role": "기초·표준·심화 경로, 선택형 과제, 소그룹 지원 설계"
