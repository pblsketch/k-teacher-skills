{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kteacher.local/schemas/hwpx-document-plan.schema.json",
  "title": "HWPX Document Plan (hwpx.document_plan.v1) — K-Teacher secondary gate",
  "description": "Fast local structural gate for the canonical -> document_plan adapter. The MCP server's own plan_validation.ok is authoritative; this schema is a secondary check.",
  "type": "object",
  "required": ["schemaVersion", "title", "metadata", "blocks"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "const": "hwpx.document_plan.v1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "document_type": {"type": "string"},
        "subject": {"type": "string"},
        "grade": {"type": "string"},
        "standard": {"type": "string"}
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["heading", "paragraph", "table", "page_break", "bullets", "memo"]
          },
          "level": {"type": "integer", "minimum": 1, "maximum": 3},
          "text": {"type": "string"},
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["key", "label"],
              "properties": {
                "key": {"type": "string"},
                "label": {"type": "string"}
              }
            }
          },
          "rows": {"type": "array"}
        }
      }
    }
  }
}
